# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
.env

# Editor / OS
.vscode/
.idea/
.DS_Store

# Vendored upstream sources are kept (reference/), but their build artefacts are not.
reference/deps/**/src/*.o
reference/deps/**/src/*.so
reference/deps/**/src/*.dll

# R build artefacts inside the vendored reference tree
reference/R/**/*.o
reference/R/**/*.so
reference/R/**/*.rds

# Local scratch
.tmp/
